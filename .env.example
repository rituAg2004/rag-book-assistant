# Mistral AI API Key (used for mistral-embed embeddings and optional Mistral chat models)
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY="your_mistral_api_key_here"

# Cohere API Key (used for ChatCohere command-r-08-2024 generation)
# Get your key at: https://dashboard.cohere.com/
COHERE_API_KEY="your_cohere_api_key_here"

# Optional: OpenAI API Key (only needed if switching to OpenAIEmbeddings)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"

# Optional: Google Gemini API Key (only needed if using GoogleGenerativeAIEmbeddings)
# Get your key at: https://aistudio.google.com/
GOOGLE_API_KEY="your_google_api_key_here"